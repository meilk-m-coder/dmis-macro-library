$$ ====================== CUSTOMER STRATEGY WRAPPERS ==========================

$$ ----------------------------------------------------------------------------
$$ VOLKSWAGEN / AUDI STRATEGY WRAPPERS
$$ ----------------------------------------------------------------------------


$$ ----------------------------------------------------------------------------
$$ MERCEDES-BENZ STRATEGY WRAPPERS
$$ ----------------------------------------------------------------------------


$$ ----------------------------------------------------------------------------
$$ BMW STRATEGY WRAPPERS
$$ ----------------------------------------------------------------------------

$$ ======================= EXPERIMENTAL STRATEGIES ============================

$$ base measure of a hexagon: via circle
M(HEX_BASE)=MACRO/ftname, dia, dept
 DECL/LOCAL,INTGR, loop, ptcnt
 DECL/LOCAL,REAL,vector_i, vector_j
 ptcnt = ASSIGN/6
 $$ My standard hold-off distance is 6.
 $$ this APPRCH/RETRCT is for probe dir of 2mm
 IF/(dia .LE. 6)
   SNSET/APPRCH,(dia/2.0)-1
   SNSET/RETRCT,(dia/2.0)-1
 ENDIF
 F(@ftname)=FEAT/CIRCLE,INNER,CART,0,0,dept,0,0,1,dia
 MEAS/CIRCLE,F(@ftname),ptcnt
  DO/loop,1,ptcnt
   vector_i = ASSIGN/COS(2 * PI * (loop -1)/ptcnt)
   vector_j = ASSIGN/SIN(2 * PI * (loop -1)/ptcnt)
   PTMEAS/CART,vector_i * dia / 2, vector_j * dia / 2, dept, -vector_i, -vector_j, 0.0
  ENDDO
 ENDMES
ENDMAC

$$ If the hexagon is larger, we can safely determine its lines
M(HEX_WITH_LINES)=MACRO/ftname, dia, dept
 DECL/LOCAL,INTGR,loop, counter, rest2, rest6
 DECL/LOCAL,REAL,outrad, crvendist, stdprt, rad1, rad2, xcoord1, ycoord1, xcoord2, ycoord2
 DECL/LOCAL,REAL,vector_i, vector_j, dia_act
 DECL/LOCAL,CHAR,15, lin_name, lin_first, lin_last, int_name, out_cir, dummy_pln, wcs_name
 DECL/LOCAL,CHAR,15, pt_names[6]
 $$ Distance of the measuring points to the line end
 $$ could be passed as an argument
 crvendist=ASSIGN/2.0
 outrad = ASSIGN/dia/SQRT(3)
 stdprt = ASSIGN/crvendist * SQRT(3)/ dia
 DO/loop,0,11
  counter = ASSIGN/INT(loop/2.0)
  rest2 = ASSIGN/loop - 2 * counter
  rad1 = ASSIGN/(30 + 60 * counter) * PI / 180
  rest6 = ASSIGN/((counter + 1) - 6 * INT((counter + 1)/6.0))
  rad2 = ASSIGN/(30 + 60 * rest6) * PI / 180
  IF/(rest2 .EQ. 0)
    xcoord2 = ASSIGN/stdprt * outrad * COS(rad1) + (1 - stdprt) * outrad * COS(rad2)
	ycoord2 = ASSIGN/stdprt * outrad * SIN(rad1) + (1 - stdprt) * outrad * SIN(rad2)
  ELSE
    xcoord1 = ASSIGN/(1 - stdprt) * outrad * COS(rad1) + stdprt * outrad * COS(rad2)
	ycoord1 = ASSIGN/(1 - stdprt) * outrad * SIN(rad1) + stdprt * outrad * SIN(rad2)
    vector_i = ASSIGN/COS(2 * PI * (counter + 1)/6)
    vector_j = ASSIGN/SIN(2 * PI * (counter + 1)/6)

	lin_name = ASSIGN/CONCAT(ftname,'_LIN', STR(counter + 1))
	F(@lin_name)=FEAT/LINE,BND,CART,xcoord1,ycoord1,dept,xcoord2,ycoord2,dept,0,0,1
     MEAS/LINE,F(@lin_name),2
     PTMEAS/CART,xcoord1, ycoord1, dept, -vector_i, -vector_j, 0
     PTMEAS/CART,xcoord2, ycoord2, dept, -vector_i, -vector_j, 0
	ENDMES

	$$ connect the line
	IF/(counter .GT. 0)
	  int_name = ASSIGN/CONCAT(ftname,'_PT', STR(counter))
	  $$ X=Umkreisradius*COS(BOGENMASS(30+60*B24))
	  $$ Y=Umkreisradius*SIN(BOGENMASS(30+60*B24))
	  xcoord1 = ASSIGN/outrad * COS((30 + 60 * (counter)) * PI / 180)
	  ycoord1 = ASSIGN/outrad * SIN((30 + 60 * (counter)) * PI / 180)

	  F(@int_name)=FEAT/POINT,CART,xcoord1,ycoord1,dept,0,0,1
      CONST/POINT,F(@int_name),INTOF,FA(@lin_last),FA(@lin_name)
      pt_names[counter] = ASSIGN/int_name

      $$ construct the last intof point
	  IF/(counter .EQ. 5)
	    xcoord1 = ASSIGN/outrad * COS((30 + 60 * (counter + 1)) * PI / 180)
	    ycoord1 = ASSIGN/outrad * SIN((30 + 60 * (counter + 1)) * PI / 180)
		int_name = ASSIGN/CONCAT(ftname,'_PT', STR(counter + 1))
		 F(@int_name)=FEAT/POINT,CART,xcoord1,ycoord1,dept,0,0,1
         CONST/POINT,F(@int_name),INTOF,FA(@lin_name),FA(@lin_first)
		 pt_names[counter+1] = ASSIGN/int_name
	  ENDIF
	ELSE
	  lin_first = ASSIGN/lin_name
	ENDIF
	lin_last = ASSIGN/lin_name
  ENDIF
 ENDDO

 $$ Outer circle from all corner points
 out_cir = ASSIGN/CONCAT(ftname,'_OUTCIR')
 F(@out_cir)=FEAT/CIRCLE,INNER,CART,0,0,dept,0,0,1,outrad * 2
 CONST/CIRCLE, F(@out_cir),BF,FA(@pt_names[1]),FA(@pt_names[2]),$
  FA(@pt_names[3]),FA(@pt_names[4]),FA(@pt_names[5]),FA(@pt_names[6])
 $$ get the actual outer diameter
 dia_act = OBTAIN/FA(@out_cir),10

 wcs_cnt = ASSIGN/wcs_cnt+1
 wcs_name = ASSIGN/CONCAT('WCS',STR(wcs_cnt))
 D(@wcs_name)=TRANS/XORIG,F(@out_cir),YORIG,F(@out_cir)

 $$ Auxiliary element: BestFit plane from all corner points
 dummy_pln = ASSIGN/CONCAT(ftname,'_DUMPLN')
 F(@dummy_pln)=FEAT/PLANE,CART,0,0,dept,0,0,1
 CONST/PLANE,F(@dummy_pln),BF,FA(@pt_names[1]),FA(@pt_names[2]),$
  FA(@pt_names[3]),FA(@pt_names[4]),FA(@pt_names[5]),FA(@pt_names[6])

 $$ Creating the inner circle with a mathematically reduced outer diameter
 F(@ftname)=FEAT/CIRCLE,INNER,CART,0,0,dept,0,0,1,dia_act / 2 * SQRT(3)
 CONST/CIRCLE,F(@ftname),PROJCT,FA(@dummy_pln),F(@ftname)
ENDMAC

M(HEX_MEASURE)=MACRO/hex_name, xyz_pos, ijk_dir, uvw_dir, dia, dept
  DECL/LOCAL,CHAR,15, lin_name, pln_name, cir_name, cir2_name, wcs_name
  DECL/LOCAL,REAL, rho
  DECL/GLOBAL,REAL, PI
  DECL/GLOBAL,INTGR, wcs_cnt
  $$ ASSIGNMENTS
  wcs_cnt = ASSIGN/0
  PI = ASSIGN/ 3.14159265
  $$
  $$ Please adjust the number of measure points for the circle
  $$ Measurement runs counterclockwise, starting point has the vector -1,0,0
  $$ With an angle moffset of 90°, for example, the first point starts at 0,-1,0
  $$ Define the hexagon as a circle in order to use the diameter for the output of the spanner size
  F(@hex_name)=FEAT/CIRCLE,INNER,CART,VECX(xyz_pos),VECY(xyz_pos),VECZ(xyz_pos),VECX(ijk_dir),VECY(ijk_dir),VECZ(ijk_dir),dia
  $$ Set the nominal feature to NULL
  wcs_cnt = ASSIGN/wcs_cnt+1
  wcs_name = ASSIGN/CONCAT('WCS',STR(wcs_cnt))
  D(@wcs_name)=TRANS/XORIG,F(@hex_name),YORIG,F(@hex_name),ZORIG,F(@hex_name)
  $$ The next line we need later to rotate around the main axis still to be defined
  $$ Attention: For Quartis we can keep the line nominal
  lin_name = ASSIGN/CONCAT(hex_name,'_LIN')
  F(@lin_name)=FEAT/LINE,UNBND,CART,0,0,0,VECX(uvw_dir),VECY(uvw_dir),VECZ(uvw_dir),0,0,1
  wcs_cnt = ASSIGN/wcs_cnt+1
  wcs_name = ASSIGN/CONCAT('WCS',STR(wcs_cnt))
  D(@wcs_name)=ROTATE/XAXIS,F(@hex_name),ZDIR
  wcs_cnt = ASSIGN/wcs_cnt+1
  wcs_name = ASSIGN/CONCAT('WCS',STR(wcs_cnt))
  D(@wcs_name)=ROTATE/YAXIS,F(@hex_name),ZDIR
  $$ let's rotate now the secondary axis
  wcs_cnt = ASSIGN/wcs_cnt+1
  wcs_name = ASSIGN/CONCAT('WCS',STR(wcs_cnt))
  D(@wcs_name)=ROTATE/ZAXIS,F(@lin_name),XDIR
  GOTO/0,0,10
  $$ if necessary, rotate the coordinate system
  $$ calculate 4 points around the hexagon with at least 3mm edge distance
  rho = ASSIGN/(dia/SQRT(3) + 3)
  pln_name = ASSIGN/CONCAT(hex_name,'_PLN')
  F(@pln_name)=FEAT/PLANE,CART,0,0,0,0,0,1
  MEAS/PLANE,F(@pln_name),4
   PTMEAS/CART,rho,0,0,0,0,1
   PTMEAS/CART,0,rho,0,0,0,1
   PTMEAS/CART,-rho,0,0,0,0,1
   PTMEAS/CART,0,-rho,0,0,0,1
  ENDMES
  wcs_cnt = ASSIGN/wcs_cnt+1
  wcs_name = ASSIGN/CONCAT('WCS',STR(wcs_cnt))
  D(@wcs_name)=ROTATE/XAXIS,FA(@pln_name),ZDIR
  wcs_cnt = ASSIGN/wcs_cnt+1
  wcs_name = ASSIGN/CONCAT('WCS',STR(wcs_cnt))
  D(@wcs_name)=ROTATE/YAXIS,FA(@pln_name),ZDIR
  wcs_cnt = ASSIGN/wcs_cnt+1
  wcs_name = ASSIGN/CONCAT('WCS',STR(wcs_cnt))
  D(@wcs_name)=TRANS/XORIG,FA(@pln_name)
  SAVE/DA(@wcs_name)
  GOTO/0,0,6
  GOTO/0,0,dept
  $$ In any case, measure a circle (by calling the HEX_BASE macro)
  cir_name = ASSIGN/CONCAT(hex_name,'_CIR')
  CALL/M(HEX_BASE),cir_name,dia,dept
  $$ Now decide what happens next based on the size
  IF/(dia .GT. 6)
    $$ Here, the measured circle is used as a preliminary alignment
    wcs_cnt = ASSIGN/wcs_cnt+1
    wcs_name = ASSIGN/CONCAT('WCS',STR(wcs_cnt))
    D(@wcs_name)=TRANS/XORIG,F(@cir_name),YORIG,F(@cir_name),ZORIG,F(@cir_name)
    $$ However, we want to determine the geometry of the hexagon based on its outer lines
	cir2_name = ASSIGN/CONCAT(hex_name,'_CIR2')
    CALL/M(HEX_WITH_LINES),cir2_name, dia, dept
	GOTO/0,0,10
	RECALL/D(WCS0)
	CONST/CIRCLE,F(@hex_name),PROJCT,FA(@cir2_name),FA(@pln_name)
  ELSE
    GOTO/0,0,10
    RECALL/D(WCS0)
	$$ Here, the measured circle is used directly as the result
    CONST/CIRCLE,F(@hex_name),PROJCT,FA(@cir_name),FA(@pln_name)
  ENDIF
ENDMAC

ENDFIL
