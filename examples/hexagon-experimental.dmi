DMISMN/'hexagon-experimental.dmi'

$$ ============================================================================
$$ EXPERIMENTAL EXAMPLE: Hexagon measurement
$$
$$ This example demonstrates the experimental HEX_MEASURE strategy.
$$
$$ The strategy represents the measured hexagon by a circle feature so that
$$ diameter, position and coordinate tolerances can be evaluated and reported.
$$
$$ The HEX_* macros are experimental and are not part of the stable POINT_*
$$ macro API.
$$
$$ Output is intentionally implemented explicitly in this example.
$$ The current POINT_OUTPUT_* macros are designed for point-like features and
$$ are not used for the circle-like result feature generated by HEX_MEASURE.
$$
$$ Probe selection, safe machine travel, clearance positions and
$$ machine-specific configuration must be validated for the target system.
$$
$$ WARNING:
$$ Do not run this example on physical measurement equipment without
$$ validating all positions, probe configurations and movements first.
$$ ============================================================================

DISPLY/TERM,DMIS,STOR,DMIS
FILNAM/'hexagon-experimental.dmo',05.2

UNITS/MM,ANGDEC
MODE/PROG,MAN

$$ ----------------------------------------------------------------------------
$$ Base coordinate system
$$ ----------------------------------------------------------------------------

D(WCS0)=TRANS/XORIG,0.0000,YORIG,0.0000,ZORIG,0.0000
SAVE/D(WCS0)

$$ ----------------------------------------------------------------------------
$$ Report header
$$ ----------------------------------------------------------------------------

R(R_DATE_HEADER)=REPORT/DATE
OUTPUT/R(R_DATE_HEADER)

R(R_TIME_HEADER)=REPORT/TIME
OUTPUT/R(R_TIME_HEADER)

$$ ----------------------------------------------------------------------------
$$ Local variables
$$ ----------------------------------------------------------------------------

DECL/LOCAL,CHAR,64,feat_name
DECL/LOCAL,CHAR,64,x_tolnm,y_tolnm,z_tolnm
DECL/LOCAL,CHAR,64,d_tolnm,p_tolnm

DECL/LOCAL,REAL,cir_dia,height1

DECL/LOCAL,VECTOR,xyz_org
DECL/LOCAL,VECTOR,ijk_vec
DECL/LOCAL,VECTOR,uvw_vec

$$ ----------------------------------------------------------------------------
$$ Experimental hexagon definition
$$
$$ xyz_org:
$$   Nominal center position of the hexagon.
$$
$$ ijk_vec:
$$   Surface vector of the hexagon.
$$
$$ uvw_vec:
$$   Orientation vector defining the rotational orientation of the hexagon.
$$
$$ cir_dia:
$$   Nominal inner-circle diameter used by the HEX_MEASURE strategy.
$$
$$ height1:
$$   Measurement depth relative to the nominal hexagon surface.
$$ ----------------------------------------------------------------------------

xyz_org = ASSIGN/VCART($
  647.500,$
  -161.902,$
  70.000)

ijk_vec = ASSIGN/VCART($
  0.00000,$
  0.00000,$
  1.00000)

uvw_vec = ASSIGN/VCART($
  0.85264,$
  -0.52250,$
  0.00000)

feat_name = ASSIGN/'HEX_1'

cir_dia = ASSIGN/22.100
height1 = ASSIGN/-0.500

$$ ----------------------------------------------------------------------------
$$ Probe configuration
$$
$$ Replace the sensor selection with a sensor configuration that is valid
$$ for the target measurement system.
$$ ----------------------------------------------------------------------------

SNSLCT/SA(2012),1

SNSET/APPRCH,6
SNSET/RETRCT,6

$$ ----------------------------------------------------------------------------
$$ Measure the hexagon
$$
$$ HEX_MEASURE uses:
$$
$$   feat_name -> name of the resulting feature
$$   xyz_org   -> nominal center position
$$   ijk_vec   -> nominal surface vector
$$   uvw_vec   -> nominal orientation vector
$$   cir_dia   -> nominal inner-circle diameter
$$   height1   -> measurement depth
$$
$$ The internal strategy may create auxiliary lines, points, planes,
$$ circles and coordinate systems while determining the resulting geometry.
$$ ----------------------------------------------------------------------------

CALL/M(HEX_MEASURE),$
  feat_name,$
  xyz_org,$
  ijk_vec,$
  uvw_vec,$
  cir_dia,$
  height1

$$ ============================================================================
$$ EXPLICIT RESULT OUTPUT
$$ ============================================================================
$$
$$ Output is intentionally kept inside this example.
$$
$$ The current POINT_OUTPUT_* macros manage output state for point features
$$ only. No generic output helper for circle-/hole-like features is available
$$ yet.
$$
$$ This example therefore creates and outputs:
$$
$$   - diameter tolerance
$$   - 3D position tolerance
$$   - X coordinate tolerance
$$   - Y coordinate tolerance
$$   - Z coordinate tolerance
$$
$$ for both nominal and actual feature results.
$$ ============================================================================

$$ ----------------------------------------------------------------------------
$$ Diameter tolerance
$$ ----------------------------------------------------------------------------

d_tolnm = ASSIGN/CONCAT(feat_name,'_D')

T(@d_tolnm)=TOL/DIAM,$
  0.000,$
  0.200

$$ ----------------------------------------------------------------------------
$$ 3D position tolerance
$$
$$ The actual feature is supplied to the position tolerance definition.
$$ ----------------------------------------------------------------------------

p_tolnm = ASSIGN/CONCAT(feat_name,'_P')

T(@p_tolnm)=TOL/POS,3D,$
  1.000,$
  FA(@feat_name)

$$ ----------------------------------------------------------------------------
$$ Output diameter and position tolerances
$$ ----------------------------------------------------------------------------

OUTPUT/F(@feat_name),$
  T(@d_tolnm),$
  T(@p_tolnm)

OUTPUT/FA(@feat_name),$
  TA(@d_tolnm),$
  TA(@p_tolnm)

$$ ----------------------------------------------------------------------------
$$ X coordinate tolerance
$$ ----------------------------------------------------------------------------

x_tolnm = ASSIGN/CONCAT(feat_name,'_X')

T(@x_tolnm)=TOL/CORTOL,XAXIS,$
  -0.500,$
  0.500

$$ ----------------------------------------------------------------------------
$$ Y coordinate tolerance
$$ ----------------------------------------------------------------------------

y_tolnm = ASSIGN/CONCAT(feat_name,'_Y')

T(@y_tolnm)=TOL/CORTOL,YAXIS,$
  -0.500,$
  0.500

$$ ----------------------------------------------------------------------------
$$ Z coordinate tolerance
$$ ----------------------------------------------------------------------------

z_tolnm = ASSIGN/CONCAT(feat_name,'_Z')

T(@z_tolnm)=TOL/CORTOL,ZAXIS,$
  -0.500,$
  0.500

$$ ----------------------------------------------------------------------------
$$ Output coordinate tolerances
$$ ----------------------------------------------------------------------------

OUTPUT/F(@feat_name),$
  T(@x_tolnm),$
  T(@y_tolnm),$
  T(@z_tolnm)

OUTPUT/FA(@feat_name),$
  TA(@x_tolnm),$
  TA(@y_tolnm),$
  TA(@z_tolnm)

$$ ----------------------------------------------------------------------------
$$ Restore standard approach/retract values
$$
$$ If the experimental HEX_* strategy modifies these values internally,
$$ establish the desired values explicitly before continuing with subsequent
$$ measurement operations.
$$ ----------------------------------------------------------------------------

SNSET/APPRCH,6
SNSET/RETRCT,6

ENDFIL
